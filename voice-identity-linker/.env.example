# Copy to .env and fill in. All values optional for local-only operation.

# Where demos, wavs, and the SQLite DB live. Defaults to ./data
DATA_DIR=./data

# Storage guardrails. Uploads are streamed and rejected above 1 GiB or when
# accepting them would leave less than 5 GiB free. Byte values can be tuned for
# the host; extraction also reserves 2x the decompressed demo size for WAVs.
MAX_UPLOAD_BYTES=1073741824
MIN_FREE_DISK_BYTES=5368709120
EXTRACTION_HEADROOM_FACTOR=2.0

# Retain only durable inputs and embeddings by default. For .dem.zst/.dem.gz,
# the generated raw .dem is removed after ingest. Failed upload artifacts are
# removed immediately; terminal UI job metadata expires after 24 hours.
DELETE_WAV_AFTER_EMBEDDING=1
RETAIN_COMPRESSED_DEMO_ONLY=1
DELETE_FAILED_UPLOADS=1
INGEST_JOB_RETENTION_HOURS=24
INGEST_JOB_HISTORY_LIMIT=100

# Speaker-verification model. ECAPA-TDNN trained on VoxCeleb.
MODEL_NAME=speechbrain/spkrec-ecapa-voxceleb

# FACEIT demo auto-sync. The game ID normally stays "cs2". Headful Chromium
# is more reliable for the one-time login; headless mode is intended for
# servers. FACEIT_CDP_ENDPOINT can attach to an existing logged-in Chrome.
FACEIT_SYNC_GAME=cs2
FACEIT_SYNC_HEADLESS=0
# FACEIT_CDP_ENDPOINT=http://127.0.0.1:9222

# Cosine-similarity threshold above which two voices are "same speaker".
# On real FACEIT CS2 data (Opus, ~150s clips) same-voice scores ~0.88 and
# different-voice scores ~0.10-0.33, so 0.5 sits cleanly in the gap. If your
# clips are shorter/noisier, re-tune with: python cli.py tune
DEFAULT_THRESHOLD=0.5

# Ternary verdict policy. Scores within +/- VERDICT_MARGIN are inconclusive.
# Definitive verdicts also require repeated windows from multiple demos for
# BOTH players and enough clip-pair agreement.
VERDICT_MARGIN=0.05
MIN_VERIFY_CLIPS=2
MIN_VERIFY_DEMOS=2
MIN_PAIR_AGREEMENT=0.75

# Bound ECAPA memory on long csgove concatenations and retain each window as a
# separate score observation.
EMBED_CHUNK_SEC=30

# Strip non-speech before embedding. Set to 0 only for a controlled raw-vs-VAD
# experiment, then re-embed and retune rather than mixing policies silently.
VAD_ENABLED=1
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_MS=250
VAD_MIN_SILENCE_MS=100
VAD_SPEECH_PAD_MS=30

# Reference player for `python cli.py scan <demo> <steamid>` — the voice you
# already have embedded and want to compare people against:
# REF_STEAMID=your_reference_steamid

# Investigative/internal mode: if "1", players who have NOT consented can
# appear in cross-account search results. Keep the privacy-preserving default
# unless a documented lawful basis and appropriate safeguards are in place.
INVESTIGATIVE_MODE=0

# Minimum seconds of speech to produce an embedding. Below MIN_CLIP_SEC the
# clip is skipped (accuracy collapses under ~2s). A warning is logged under
# WARN_CLIP_SEC.
MIN_CLIP_SEC=2.0
WARN_CLIP_SEC=3.0
